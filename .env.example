# Copy this file to .env for local testing (.env is git-ignored — never
# commit real secrets). In production, set these as environment variables
# in the Railway dashboard instead — do not deploy a .env file.

# Resend API key — Resend dashboard → API Keys → Create API Key
RESEND_API_KEY=

# Must be on a domain verified in Resend (Resend dashboard → Domains).
# Format: "Display Name <address@yourdomain.com>"
RESEND_FROM=360 Coating Solutions <notifications@360coatingsolutions.com>

# Every contact-form submission is delivered here — homeowner and builder
# inquiries both land in this one inbox today (client's decision), but the
# email is still tagged by type via its subject line and an
# X-360-Inquiry-Type header, so nothing is lost by sharing one address.
CONTACT_EMAIL_ADMIN=admin@360coatingsolutions.com

# Optional — only set these if you later want the two audiences split into
# separate inboxes again. Each one independently overrides the shared
# CONTACT_EMAIL_ADMIN above; no code change needed either way.
# CONTACT_EMAIL_HOMEOWNER=
# CONTACT_EMAIL_BUILDER=

# Optional — Express falls back to 3001 if unset. Railway sets this
# automatically in production; no action needed there.
PORT=3001
