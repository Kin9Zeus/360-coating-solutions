# Raw AI-generated video sources (~90 MB) — kept locally only. The site
# actually uses the compressed src/assets/videos/*-web.mp4 and
# *-poster.webp derivatives generated from these; the originals aren't
# imported anywhere and don't need to travel with the deploy repo.
src/assets/main_hero_section_video.mp4
src/assets/videos/*_video.mp4
src/assets/videos/*_video_*.mp4

